{
  "_notes": "Filing type headings → FilingType enum. Used when file path can't identify the form type unambiguously.",

  "normalization": {
    "case_insensitive": true,
    "collapse_whitespace": true,
    "strip_punctuation": true,
    "strip_prefixes": ["form"]
  },

  "entries": {
    "ten_k": {
      "canonical": "TEN_K",
      "keywords": ["10-K", "annual report"],
      "variants": [
        "FORM 10-K",
        "Form 10-K",
        "Annual Report on Form 10-K",
        "Annual Report"
      ],
      "fuzzy_threshold": 90
    },

    "ten_q": {
      "canonical": "TEN_Q",
      "keywords": ["10-Q", "quarterly report"],
      "variants": [
        "FORM 10-Q",
        "Form 10-Q",
        "Quarterly Report on Form 10-Q",
        "Quarterly Report"
      ],
      "fuzzy_threshold": 90
    },

    "eight_k": {
      "canonical": "EIGHT_K",
      "keywords": ["8-K", "current report"],
      "variants": [
        "FORM 8-K",
        "Form 8-K",
        "Current Report on Form 8-K"
      ],
      "fuzzy_threshold": 90
    },

    "press_release": {
      "canonical": "PRESS_RELEASE",
      "keywords": ["press release", "announces", "reports financial results", "reports results"],
      "variants": [
        "Press Release",
        "Earnings Release",
        "Earnings Announcement"
      ],
      "fuzzy_threshold": 80
    }
  }
}
