handoff#Structure#{3}":[103,103],"#April 28th — Quarterly Forecasting Layer Session#How to create the next handoff#Structure#{4}":[104,104],"#April 28th — Quarterly Forecasting Layer Session#How to create the next handoff#Structure#{5}":[105,105],"#April 28th — Quarterly Forecasting Layer Session#How to create the next handoff#Structure#{6}":[106,106],"#April 28th — Quarterly Forecasting Layer Session#How to create the next handoff#Structure#{7}":[107,107],"#April 28th — Quarterly Forecasting Layer Session#How to create the next handoff#Structure#{8}":[108,108],"#April 28th — Quarterly Forecasting Layer Session#How to create the next handoff#Structure#{9}":[109,110],"#April 28th — Quarterly Forecasting Layer Session#How to create the next handoff#Consolidation rules":[111,118],"#April 28th — Quarterly Forecasting Layer Session#How to create the next handoff#Consolidation rules#{1}":[113,113],"#April 28th — Quarterly Forecasting Layer Session#How to create the next handoff#Consolidation rules#{2}":[114,114],"#April 28th — Quarterly Forecasting Layer Session#How to create the next handoff#Consolidation rules#{3}":[115,115],"#April 28th — Quarterly Forecasting Layer Session#How to create the next handoff#Consolidation rules#{4}":[116,116],"#April 28th — Quarterly Forecasting Layer Session#How to create the next handoff#Consolidation rules#{5}":[117,118]},"outlinks":[],"metadata":{"type":"session-handoff","date":"2026-04-28","topic":"Built `model-qtr-derive` (single-quarter sheets layer over YTD) and rebuilt `model-calc` from scratch as a quarterly-first forecasting engine. Drivers infer per-row from canonical filing_section + label heuristics (no hand-curated DRIVER_SPECS), then centralize on IS/BS/CF DRIVERS tabs as the single place the user overrides. Source-sheet forecast cells = lookups (value/computed kinds) or rate-applied formulas (ratio kinds). Several sign bugs caught + fixed along the way (Net Change in Cash circular, RE rollforward, dividend payout sign, PP&E rollforward direction, DTA rollforward). PEP_model_v9.xlsx is the locked end-state.","tags":["#session","#model-calc-rebuild","#model-qtr-derive","#quarterly-forecasting","#driver-inference","#centralized-drivers"]},"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:Sessions/CELH Model/Handoffs/April 28th Quarterly Forecasting Layer Session.md#---frontmatter---": {"path":null,"last_embed":{"hash":"tzn4yf","at":1777382909080},"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.06483208,0.00069353,0.05002767,0.01925036,-0.01323671,0.0275326,-0.05183811,0.01118033,0.03041903,-0.00693213,-0.01211953,0.01719663,0.04172929,-0.00339345,0.03638593,-0.00237777,-0.0217463,-0.00004564,0.07078518,-0.0392996,0.04276249,-0.04264499,-0.0780909,-0.00306972,0.03399101,-0.00242935,-0.04338929,-0.08175413,-0.06821672,-0.24419041,-0.05419402,0.06620008,-0.05249248,-0.00955847,0.01065398,-0.01389859,-0.01268775,0.06025301,0.04960177,0.02960083,0.0364278,0.08965113,-0.03907727,-0.06581169,0.02752037,-0.05980893,-0.02743547,0.03821791,0.00254324,0.00673665,0.0245242,0.01270282,-0.02394308,0.00113193,0.00311309,0.01578674,0.03716599,0.01312983,0.02884718,0.04722753,0.00920382,0.04914854,-0.22416154,0.04758895,-0.02907554,0.01994091,0.03011658,-0.01223556,0.0270028,0.05218517,-0.01213739,-0.02673363,-0.01857466,-0.00795406,0.04969383,-0.08123557,-0.00287698,-0.02023673,-0.00323564,-0.00532259,-0.05143631,0.06746658,-0.04533752,0.04916542,-0.01878371,-0.04321645,0.03286663,-0.03133633,0.04545197,-0.00701353,-0.02501313,-0.03090256,0.00214763,0.0272925,-0.04459099,0.00464744,0.0466445,0.01166143,-0.04363319,0.12655488,-0.00962688,0.02851007,0.00249539,-0.0015242,0.03340646,-0.02489414,-0.01722796,-0.03003363,-0.01666396,-0.05685682,-0.04788728,-0.0026211,-0.02078858,-0.0806591,-0.02994871,-0.01648883,0.06256235,0.03652051,0.07192351,0.00560083,0.01077378,-0.02413514,0.07016533,-0.04826864,0.01398935,0.01483748,0.06284041,0.07244591,-0.01027373,-0.02187449,0.04862187,0.02240665,-0.