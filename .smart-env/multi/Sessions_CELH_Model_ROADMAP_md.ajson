ural + coverage#{3}":[269,269],"#Celsius HF Case Study — Roadmap#Later horizon — architectural + coverage#{4}":[270,270],"#Celsius HF Case Study — Roadmap#Later horizon — architectural + coverage#{5}":[271,271],"#Celsius HF Case Study — Roadmap#Later horizon — architectural + coverage#{6}":[272,272],"#Celsius HF Case Study — Roadmap#Later horizon — architectural + coverage#{7}":[273,273],"#Celsius HF Case Study — Roadmap#Later horizon — architectural + coverage#{8}":[274,275],"#Celsius HF Case Study — Roadmap#Later horizon — architectural + coverage#{9}":[276,277],"#Celsius HF Case Study — Roadmap#Deferred / out of scope":[278,286],"#Celsius HF Case Study — Roadmap#Deferred / out of scope#{1}":[280,280],"#Celsius HF Case Study — Roadmap#Deferred / out of scope#{2}":[281,281],"#Celsius HF Case Study — Roadmap#Deferred / out of scope#{3}":[282,282],"#Celsius HF Case Study — Roadmap#Deferred / out of scope#{4}":[283,284],"#Celsius HF Case Study — Roadmap#Deferred / out of scope#{5}":[285,286],"#Celsius HF Case Study — Roadmap#Known small issues (tracked, non-blocking)":[287,293],"#Celsius HF Case Study — Roadmap#Known small issues (tracked, non-blocking)#{1}":[289,289],"#Celsius HF Case Study — Roadmap#Known small issues (tracked, non-blocking)#{2}":[290,291],"#Celsius HF Case Study — Roadmap#Known small issues (tracked, non-blocking)#{3}":[292,293],"#Celsius HF Case Study — Roadmap#Key references":[294,327],"#Celsius HF Case Study — Roadmap#Key references#{1}":[296,327]},"outlinks":[],"metadata":{"type":"roadmap","date":"2026-04-29","project":"Celsius HF Case Study","scope":"CELH financial model pipeline + universal model creation architecture + (later) GLP-1 / SNAP integration","last_session":"April 29th MNST Onboarding Session","next_objective":"Inventory breakdown — split RM / WIP / FG into separate workbook line items when filers disclose them. Currently GEN-BS-038 absorbs InventoryRawMaterials* / InventoryWorkInProcess* / InventoryFinishedGoods* concepts as a single memo bucket; the workbook only renders GEN-BS-005 'Inventories' (Net rollup). PG and PEP both disclose breakdowns that get collapsed today. Plan: 3 new BS canonicals (Raw Materials / Work in Process / Finished Goods) as line_items in current_assets, plus model-write conditional layout (Net renders as a `=SUM(detail)` subtotal formula when detail is present, single line_item otherwise), plus BS-1 subtotal-exclusion handling, plus model-calc forecast routing (RATIO_OF_REV per detail row, DERIVED on the Net subtotal). Estimated lift: ~3–5 hours. After inventory: resume systematic driver-kind determination (replace remaining `_label_contains` substring checks in inference.py with structural canonical metadata)."},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"Sessions/CELH Model/ROADMAP.md"},"smart_blocks:Sessions/CELH Model/ROADMAP.md#---frontmatter---": {"path":null,"last_embed":{"hash":"10j0q1u","at":1777476867253},"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.02487713,-0.01589308,0.06109303,-0.03964507,0.00219247,-0.01168521,-0.05177552,-0.00377554,0.01025021,0.01044595,-0.01916128,0.00027232,0.03407634,0.02378629,-0.01214278,-0.01581207,-0.02165414,-0.00057325,-0.01426276,0.01018603,0.04708081,-0.05560129,-0.07771476,0.01583851,0.03218428,0.05770456,0.00811598,-0.07331212,-0.07657384,-0.26314858,-0.03267731,-0.00836283,0.00384036,0.00356175,0.03726086,0.0057856,-0.01795379,0.09710157,-0.00860518,0.01979652,0.04594354,0.05366135,-0.07363812,0.03680566,0.03688427,-0.0463761,-0.03379947,0.03583585,-0.02919108,-0.01626988,-0.00309636,-0.01700532,-0.0416995,-0.01922593,-0.03589977,-0.00952131,0.04699387,0.01102264,0.01467656,0.04533006,0.0038988,0.01197038,-0.23386967,0.03830291,0.00201902,0.03506207,-0.01125185,-0.0458439,0.05045535,0.06835106,-0.04281921,-0.03499944,0.02291239,0.03467303,0.03803916,-0.03203036,0.04118263,-0.01640507,0.02551312,-0.04451523,-0.01139278,0.05587928,-0.018836,0.02808837,-0.02310621,-0.0399215,-0.00758705,0.00304953,0.054418