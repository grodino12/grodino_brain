n current_assets, plus model-write conditional layout (Net renders as a `=SUM(detail)` subtotal formula when detail is present, single line_item otherwise), plus BS-1 subtotal-exclusion handling, plus model-calc forecast routing (RATIO_OF_REV per detail row, DERIVED on the Net subtotal). Estimated lift: ~3–5 hours. After inventory: resume systematic driver-kind determination (replace remaining `_label_contains` substring checks in inference.py with structural canonical metadata)."},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"Sessions/CELH Model/ROADMAP.md"},"smart_blocks:Sessions/CELH Model/ROADMAP.md#Celsius HF Case Study — Roadmap": {"path":null,"last_embed":{"hash":"krapdz","at":1777477081260},"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.08209303,-0.00416254,0.02021885,0.01289434,-0.03925502,0.01711229,-0.0587354,0.01182011,0.01967456,-0.0168742,0.0147903,0.01439954,0.0021533,-0.00547867,-0.02890106,-0.00646863,-0.04705133,0.04747014,0.02445783,0.02804261,0.01154843,-0.05714967,0.00004189,-0.00140082,0.0119568,0.02102282,0.00072701,-0.01328595,-0.09201682,-0.28010058,-0.01413013,-0.01476252,0.00220675,0.0313824,-0.01740095,-0.02668916,-0.013332,0.08103871,0.01140583,0.02029514,0.04888608,0.05059631,-0.04319992,-0.01788289,0.02133132,-0.02192005,-0.05820929,0.07323541,-0.07836113,-0.0167912,-0.0149201,-0.06641234,-0.00640997,0.00915198,-0.01032714,0.00281391,0.05506641,-0.00394872,0.04802277,0.0210301,-0.01710828,0.05395222,-0.24431339,0.05590978,0.0051083,0.01256339,-0.05207599,-0.01762415,0.04254293,0.07745433,-0.03108434,-0.00113094,0.01074934,0.04408483,0.0397546,-0.05633182,-0.00591988,-0.00376097,0.01784288,-0.03090301,0.0094501,0.05821933,-0.04067516,0.01554954,-0.02248348,-0.054912,0.00157564,-0.02925747,0.05553302,-0.0069718,-0.01719398,-0.0724327,0.01326092,0.00896059,-0.04571352,0.00847197,0.02193923,-0.01061305,-0.01696883,0.0966841,-0.02458939,-0.02439835,-0.00491837,0.00437751,0.08240568,-0.06225085,-0.03168099,0.02687215,-0.02684433,